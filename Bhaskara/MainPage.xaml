<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Bhaskara.MainPage">

    <ScrollView>
        <VerticalStackLayout Padding="10" Spacing="25">
            <Image Source="bhaskaraf.png" Aspect="AspectFit"/>

            <Label Text="Calculadora de Bhaskara" FontSize="20" HorizontalOptions="Center" FontAttributes="Bold"/>

            <Label Text="Digite os valores dos coeficientes (ax² + bx + c):" FontSize="15"/>

            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                <Label Text="(" FontSize="Large"/>
                <Entry x:Name="valA" Placeholder="a" Keyboard="Numeric" WidthRequest="60"/>
                <Label Text="," FontSize="Large"/>
                <Entry x:Name="valB" Placeholder="b" Keyboard="Numeric" WidthRequest="60"/>
                <Label Text="," FontSize="Large"/>
                <Entry x:Name="valC" Placeholder="c" Keyboard="Numeric" WidthRequest="60"/>
                <Label Text=")" FontSize="Large"/>
            </HorizontalStackLayout>

            <Button x:Name="btCalcular" Text="Calcular Raízes" HorizontalOptions="Fill" Clicked="btCalcular_Clicked"/>

            <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                <Label x:Name="lbDelta" Text="Delta: 0,00" FontSize="15"/>
                <Label x:Name="lbResultado" Text="X1: 0,00 | X2: 0,00" FontAttributes="Bold" TextColor="BlueViolet" FontSize="15"/>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>